TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SITE_NAME=ALITT7
DATABASE_PATH=./data/messages.db
MAX_MESSAGE_LENGTH=1200
RATE_LIMIT_SECONDS=45
# Only set this to true if you are SURE a reverse proxy in front of this app
# (e.g. the hosting platform's edge) overwrites the X-Forwarded-For header
# itself. If left false/unset, the rate limiter uses the direct TCP peer
# address instead, which visitors cannot spoof.
TRUST_PROXY_HEADERS=false
# Used by run.py only (python run.py). Not used by the Dockerfile.
PORT=8000
RELOAD=false
# Python logging level for the app's own logger (Telegram failures, storage
# failures, unhandled exceptions). One of DEBUG/INFO/WARNING/ERROR.
LOG_LEVEL=INFO
